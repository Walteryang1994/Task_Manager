<Window x:Class="Task_Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Manager" Height="620" Width="980" WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#2f4f4f" Padding="16" CornerRadius="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Task Manager" FontSize="28" FontWeight="Bold" Foreground="White"/>
                <TextBlock x:Name="UrgentNoticeText" Text="No urgent tasks today." Foreground="#dff7f7" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#f7f7f7" CornerRadius="10" Padding="12" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Add a task" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>

                    <TextBlock Text="Title" Margin="0,0,0,4"/>
                    <TextBox x:Name="TitleTextBox" Height="30" Margin="0,0,0,10"/>

                    <TextBlock Text="Description" Margin="0,0,0,4"/>
                    <TextBox x:Name="DescriptionTextBox" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Due date" Margin="0,0,0,4"/>
                            <DatePicker x:Name="DueDatePicker" Height="30"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="Priority" Margin="0,0,0,4"/>
                            <ComboBox x:Name="PriorityComboBox" Height="30">
                                <ComboBoxItem Content="High" IsSelected="True"/>
                                <ComboBoxItem Content="Normal"/>
                                <ComboBoxItem Content="Low"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Button x:Name="AddTaskButton" Content="Add Task" Height="36" Background="#2f4f4f" Foreground="White" FontWeight="SemiBold" Click="AddTaskButton_Click"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#ffffff" CornerRadius="10" Padding="12" Margin="0,0,0,12">
                    <DockPanel>
                        <TextBlock Text="Current Tasks" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                        <ListBox x:Name="TaskListBox" DisplayMemberPath="Title" DockPanel.Dock="Top" SelectionChanged="TaskListBox_SelectionChanged"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="1" Background="#ffffff" CornerRadius="10" Padding="12">
                    <DockPanel>
                        <TextBlock Text="History" FontSize="18" FontWeight="SemiBold" DockPanel.Dock="Top" Margin="0,0,0,10"/>
                        <ListBox x:Name="HistoryListBox" DisplayMemberPath="Title" DockPanel.Dock="Top"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
